# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e
# preencha os valores reais antes de rodar "docker compose up".
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha
DB_PORT=5433

# Opcional: só preencha se quiser apontar pra um Postgres que NÃO é o do
# docker-compose — por exemplo o Supabase, que é o banco de produção. Quando
# DATABASE_URL está definida, ela ganha de DB_HOST/DB_PORT/DB_NAME.
# No Supabase, use a string do "Session pooler" (porta 5432) e lembre que o
# usuário vira "postgres.<ref-do-projeto>":
# DATABASE_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=troque-este-segredo-em-producao-min-32-caracteres
OPENAI_API_KEY=sk-...
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Endereço do front, usado nos links que o backend gera: convite de teste,
# convite de equipe e recuperação de senha. Em produção, a URL da Vercel.
FRONTEND_BASE_URL=http://localhost:5173

# Validade dos testes de empresa, em meses, contada da criação (opcional, padrão 3).
# ASSESSMENT_VALIDITY_MONTHS=3

# Envio de email (opcional). Sem MAIL_HOST, o backend só loga o link no console
# em vez de enviar — os convites e a recuperação de senha seguem funcionando pelo link.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@entrevista-ia.local
